##################################################################### 锚点 start #####################################################################
test_url1: &test_url1 https://www.gstatic.com/generate_204
includeNodes_CN: &includeNodes_CN "国内|北京|上海|江苏|浙江|广东|四川|成都|移动|联通|电信"
excludeNodes_CN: &excludeNodes_CN "香港|分流|校园|配合|官网|2倍|3倍|5倍|10倍"
includeNodes_GN: &includeNodes_GN "剩余流量|套餐到期|春川|HK|JP|443|Kcp|Reality|HY2|中转|CDN|非免流|★|✰"
excludeNodes_GN: &excludeNodes_GN "国内|北京|上海|江苏|浙江|广东|四川|移动|联通|电信|客户|校园|配合|官网|2x|3x|5x|10x|★★|✰✰|★★★|✰✰✰"
#####################################################################  锚点 end  #####################################################################

mixed-port: 10100                 # HTTP(S) 和 SOCKS 代理混合端口
allow-lan: false                  # 允许局域网连接
bind-address: "*"                 # 绑定IP地址，仅作用于 allow-lan 为 true，'*'表示所有地址
authentication:
- "jjzmvp:$jjzmvp@123"
# 控制 Clash 发出 TCP Keep Alive 包的间隔，减少移动设备耗电问题的临时措施
keep-alive-interval: 90
# TCP Keep Alive 的最大空闲时间
keep-alive-idle: 900
#  find-process-mode has 3 values: always, strict, off
#  - always, 开启，强制匹配所有进程
#  - strict, 默认，由clash判断是否开启
#  - off, 不匹配进程，推荐在路由器上使用此模式
find-process-mode: strict
unified-delay: true   # 统一延迟
mode: rule            # 运行模式 direct/rule/script/global
log-level: info       # 日志等级 silent/error/warning/info/debug
ipv6: false           # 开启IPv6总开关(测试网址： https://api-ipv6.ip.sb/ip)
udp: true             # 开启udp
tcp-concurrent: false # TCP并发连接所有IP, 将使用最快握手的TCP

geodata-mode: true    # 使用dat格式的geo文件
# Geo文件加载模式，standard/memconservative, memconservative模式专为内存受限 (小内存) 设备优化的加载器 (默认值)
geodata-loader: memconservative  
#自定义 geox-url
geox-url:
  geoip:   "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat"
  geosite: "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat"

profile:
  store-selected: true  # 储存 API 对策略组的选择，以供下次启动时使用
  store-fake-ip:  true  # 储存 fakeip 映射表，域名再次发生连接时，使用原有映射

# 嗅探域名 可选配置
sniffer:
  enable: true
  ## 对 redir-host 类型识别的流量进行强制嗅探
  ## 如：Tun、Redir 和 TProxy 并 DNS 为 redir-host 皆属于
  force-dns-mapping: true
  ## 对所有未获取到域名的流量进行强制嗅探
  parse-pure-ip: true
  # 是否使用嗅探结果作为实际访问，默认 false
  # 全局配置，优先级低于 sniffer.sniff 实际配置
  override-destination: false
  sniff:
    # TLS 默认如果不配置 ports 默认嗅探 443
    TLS:
      ports: [443, 8443]
      # ports: [443, 2053, 2083, 2087, 2096, 8443, 853, 8000-9999, 5228-5230]
      
    # 自1.17版本开始支持quic协议
    QUIC:
      ports: [443, 8443]

    # 默认嗅探 80
    HTTP:
      # 需要嗅探的端口
      ports: [80, 8000-8880]
      # ports: [80, 8080-8880, 2052, 2082, 2086, 2095, 853, 8000-9999, 5228-5230]
      # 可覆盖 sniffer.override-destination
      override-destination: true
  # 白名单，对嗅探结果进行跳过
  skip-domain:
    - "+.apple.com"
    - "Mijia Cloud"
    - "+.mi.com"
    - "+.jd.com"
    - "+.baidu.com"

external-controller: '127.0.0.1:9876'
secret: '$jjzmvp@123'
external-ui: 'ui/metacubexd'
external-ui-url: 'https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip'

# 类似于 /etc/hosts, 仅支持配置单个 IP
hosts:
  "localhost": 127.0.0.1
  "dns.google": 8.8.8.8
  "*.clash.dev": 127.0.0.1

# Tun配置
tun:
  enable: true
  device: MetaTun-Wifi
  stack: mixed                 # system / gvisor / mixed / lwip
  dns-hijack:
    - any:53
    - tcp://any:53
  auto-route: true             # 配置路由表
  auto-detect-interface: true  # 自动识别出口网卡
  mtu: 1500                    # 最大传输单元
  strict-route: false          # 将所有连接路由到tun来防止泄漏，但你的设备将无法其他设备被访问

# DNS配置
dns:
  enable: true                 # 关闭将使用系统 DNS
  ipv6: false                  # false 将返回 AAAA 的空结果
  listen: 0.0.0.0:1053         # 开启 DNS 服务器监听
  use-hosts: false             # 关闭hosts
  use-system-hosts: true       # 开启系统hosts
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16 # fake-ip 池设置
  fake-ip-filter:
    - rule-set:fakeip-filter
    - 'geosite:private'
    - 'geosite:category-public-tracker'
  default-nameserver: # 基础DNS服务器，必须先有它才能使用域名类型的DNS配置，因此必须为IP，此处使用阿里云DNS
    - 'https://223.5.5.5/dns-query#🇨🇳 腾讯成都-TCP'
    - 'https://223.6.6.6/dns-query#🇨🇳 腾讯成都-TCP'
    - 'https://119.29.29.29/dns-query#🇨🇳 腾讯成都-TCP'
  nameserver: # 在访问的国外网站没有匹配到任何域名规则，最终走了MATCH兜底规则时使用的DNS，为了确保不发生DNS泄漏和DNS污染，必须使用国外DNS
    - 'https://1.1.1.1/dns-query#🇭🇰 腾讯HK1-TCP'
    - 'https://8.8.8.8/dns-query#🇭🇰 腾讯HK1-TCP'
  proxy-server-nameserver: # 解析代理节点时使用的DNS，为了使下面的respect-rules生效必须设置，最好设置为国内DNS，否则在代理的第一步就可能因为连接不上国外DNS而解析不出代理节点的IP，最终倒在起点
    - 'https://dns.alidns.com/dns-query#🇨🇳 腾讯成都-TCP'
    - 'https://doh.pub/dns-query#🇨🇳 腾讯成都-TCP'
  direct-nameserver: # 规则匹配到直连时使用的DNS，既然是可以直连的，当然要用国内DNS
    - 'https://dns.alidns.com/dns-query#🇨🇳 腾讯成都-TCP'
    - 'https://doh.pub/dns-query#🇨🇳 腾讯成都-TCP'
  respect-rules: true # 让连接DNS服务器时能够遵循规则，也就是通过代理节点连接到上面设置的国外DNS，因为直连可能连接不上

### 规则配置
RuleSet_domain: &RuleSet_domain
  type: http
  behavior: domain
  interval: 86400
  proxy: 🇭🇰 腾讯HK1-TCP

rule-providers:
  fakeip-filter:
    <<: *RuleSet_domain
    format: mrs
    path: "./RuleProviders/fakeip-filter.mrs"
    url: "https://github.com/DustinWin/ruleset_geodata/releases/download/mihomo-ruleset/fakeip-filter.mrs"

# Start- 机场相关配置(关键词：Airport)
proxy-providers:
  ✈️ Airport_quick:
    url: https://sub1.qingze-quick.top/api/v1/client/subscribe?token=9e4224e1aaaa7c464ac49dd20a88b736
    type: "http"
    path: "./ProxyProviders/quick.yaml"
    proxy: 🇭🇰 腾讯HK1-TCP
    interval: 43210
    health-check:
      enable: true
      interval: 600
      lazy: false
      url: *test_url1

  ✈️ Airport_shen7:
    url: https://sub.imtp.eu.org/api/v1/client/subscribe?token=8ddeb620daafb4cd03a1284e01252b11
    type: "http"
    path: "./ProxyProviders/shen7.yaml"
    proxy: 🇭🇰 腾讯HK1-TCP
    interval: 43210
    health-check:
      enable: true
      interval: 600
      lazy: false
      url: *test_url1

  ✈️ My_nodes:
    url: https://raw.githubusercontent.com/jjzmvp/MyDictionaryText/refs/heads/ma1n/test2026/share/sub/tencent22002
    type: "http"
    path: "./ProxyProviders/My_nodes.yaml"
    proxy: 🇭🇰 腾讯HK1-TCP
    interval: 0
    health-check:
      enable: true
      interval: 600
      lazy: false
      url: *test_url1
# End - 机场相关配置

proxy-groups:
  - name: "🎯 国内-手动-Windows"
    type: select
    proxies:
      - DIRECT
      - ⚡️ 国内-机场-自动测速
    # 国内继机场配置
    filter: *includeNodes_CN
    exclude-filter: *excludeNodes_CN
    use:
      - ✈️ My_nodes
      - ✈️ Airport_quick

  - name: "🌏 国外-手动-Windows"
    type: select
    proxies:
      - REJECT
      - ☄️ 国外-机场-自动测速
      - ♻️ 国外-自动-故障转移
      - ⚖️ 国外-负载均衡-轮询
    #国外机场配置
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - ✈️ My_nodes
      - ✈️ Airport_shen7

  - name: "⚡️ 国内-机场-自动测速"
    type: url-test
    url: *test_url1
    interval: 333
    lazy: true
    # 国内继机场配置
    filter: *includeNodes_CN
    exclude-filter: *excludeNodes_CN
    use:
      - ✈️ Airport_quick

  - name: "☄️ 国外-机场-自动测速"
    type: url-test
    url: *test_url1
    interval: 333
    lazy: true
    # 国内继机场配置
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - ✈️ Airport_shen7

  - name: "♻️ 国外-自动-故障转移"
    type: fallback
    url: *test_url1
    interval: 333
    lazy: true
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    #proxies:
    #  - ⚖️ 国外-负载均衡-轮询
    use:
      - ✈️ Airport_shen7
      - ✈️ Airport_quick

  - name: "⚖️ 国外-负载均衡-轮询"
    type: load-balance
    url: *test_url1
    interval: 333
    lazy: true
    strategy: round-robin
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - ✈️ My_nodes

  - name: "🇨🇳 腾讯成都-TCP"
    type: url-test
    url: *test_url1
    interval: 333
    lazy: true
    filter: '腾讯成都'
    use:
      - ✈️ My_nodes

  - name: "🇭🇰 腾讯HK1-TCP"
    type: url-test
    url: *test_url1
    interval: 333
    lazy: true
    filter: '腾讯HK1'
    use:
      - ✈️ My_nodes

  - name: "🇯🇵 腾讯JP1-TCP"
    type: url-test
    url: *test_url1
    interval: 333
    lazy: true
    filter: '腾讯JP1'
    use:
      - ✈️ My_nodes

