mixed-port: 10100                # HTTP(S) 和 SOCKS 代理混合端口
bind-address: "*"                # 绑定IP地址，仅作用于 allow-lan 为 true，"*"表示所有地址
allow-lan: false                 # 允许局域网连接
lan-allowed-ips:                 # 允许局域网连接IP地址段
  - 192.168.0.0/16
  - fe80::/10
authentication:                  # http(s)/socks/mixed代理的用户验证
- "jjzmvp:$jjzmvp@123"
keep-alive-interval: 90          # 控制 Clash 发出 TCP Keep Alive 包的间隔，减少移动设备耗电问题的临时措施
keep-alive-idle: 900             # TCP Keep Alive 的最大空闲时间
find-process-mode: strict        #  always, strict, off：- always, 开启，强制匹配所有进程；- strict, 默认，由clash判断是否开启；- off, 不匹配进程，推荐在路由器上使用此模式
unified-delay: true              # 统一延迟
mode: rule                       # 运行模式 direct/rule/script/global
log-level: info                  # 日志等级 silent/error/warning/info/debug
ipv6: false                      # 开启IPv6总开关
udp: true                        # 开启udp
tcp-concurrent: false            # TCP并发连接所有IP, true:将使用最快握手的TCP

geodata-mode: true               # 使用dat格式的geo文件
geodata-loader: memconservative  # Geo文件加载模式，standard/memconservative, memconservative模式专为内存受限 (小内存) 设备优化的加载器 (默认值)
geox-url:                        #自定义 geox-url
  geoip:   "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb:    "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.metadb"

profile:
  store-selected: true           # 储存 API 对策略组的选择，以供下次启动时使用
  store-fake-ip:  true           # 储存 fakeip 映射表，域名再次发生连接时，使用原有映射
  
# 嗅探域名 可选配置
sniffer:
  enable: true                   # 启用 sniffer
  force-dns-mapping: true        # 对 redir-host 类型识别的流量进行强制嗅探
  parse-pure-ip: true            # 对所有未获取到域名的流量进行强制嗅探
  override-destination: false    # 是否使用嗅探结果作为实际访问，默认为true
  sniff:                         # 需要嗅探的协议设置，仅支持 HTTP/TLS/QUIC，优先级低于 sniffer.sniff 实际配置
    TLS:                         # TLS 默认如果不配置 ports 默认嗅探 443
      ports: [443, 8443]
      # ports: [443, 2053, 2083, 2087, 2096, 8443, 853, 8000-9999, 5228-5230]

    QUIC:                        # 自1.17版本开始支持quic
      ports: [80, 443, 8443]

    HTTP:
      ports: [80, 8000-8880]
      # ports: [80, 8080-8880, 2052, 2082, 2086, 2095, 853, 8000-9999, 5228-5230]
      override-destination: true # 可覆盖全局设置 sniffer.override-destination
  skip-domain:                   # 白名单，对嗅探结果进行跳过
    - "+.apple.com"
    - "Mijia Cloud"
    - "+.mi.com"
    - "+.jd.com"
    - "+.baidu.com"

# 外部控制器
external-controller: "127.0.0.1:9876"
secret: "$jjzmvp@123"
external-ui: "ui/zashboard"
external-ui-url: "https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip"

# 类似于 /etc/hosts, 仅支持配置单个 IP
hosts:
  "localhost": 127.0.0.1
  "dns.google": 8.8.8.8

# NTP配置
ntp:
  enable: true
  write-to-system: false
  server: "ntp.aliyun.com"
  port: 123
  interval: 300
  dialer-proxy: ⚡️ 腾讯HK1-自动测速

# Tun配置
tun:
  enable: true
  device: MetaTun-联通手厅
  stack: mixed                   # system / gvisor / mixed / lwip
  dns-hijack:
    - any:53
    - tcp://any:53
  auto-route: true               # 配置路由表
  auto-detect-interface: true    # 自动识别出口网卡
  mtu: 4064                      # 最大传输单元
  strict-route: true             # 将所有连接路由到tun来防止泄漏，但你的设备将无法通过其他设备被访问

# DNS配置
dns:
  enable: true                   # 关闭将使用系统 DNS
  prefer-h3: false               # false 将禁止DOH优先使用http/3
  ipv6: false                    # false 将返回 AAAA 的空结果
  listen: 0.0.0.0:1053           # 开启 DNS 服务器监听
  use-hosts: false               # 关闭配置hosts
  use-system-hosts: true         # 开启系统hosts
  respect-rules: false           # 让连接DNS服务器时能够遵循规则，也就是通过代理节点连接到上面设置的国外DNS，因为直连可能连接不上
  enhanced-mode: fake-ip         # DNS处理模式: fake-ip/redir-host(默认)
  fake-ip-range: 198.18.0.1/16   # fake-ip 池设置
  fake-ip-range6: ""             # fakeip 下的 IPv6 段设置
  fake-ip-filter-mode: blacklist # 可选 blacklist/whitelist/rule，默认blacklist，whitelist 即只有匹配成功才返回 fake-ip
  fake-ip-ttl: 1                 # 配置fakeip查询返回的TTL，非必要情况下请勿修改
  fake-ip-filter:                # fakeip 过滤，以下地址不会下发 fakeip 映射用于连接
    - "rule-set:🚥 fakeip-filter"
    - "geosite:private"
    - "geosite:category-public-tracker"
  default-nameserver:            # 基础DNS服务器，必须先有它才能使用域名类型的DNS配置，因此必须为IP，此处使用阿里云和腾讯DNS，优先使用DNS over HTTPS (DoH) (https://)方式加密
    - "https://223.5.5.5/dns-query#⚡️ 腾讯成都-自动测速"
    - "https://119.29.29.29/dns-query#⚡️ 腾讯成都-自动测速"
  proxy-server-nameserver:       # 解析代理节点时使用的DNS，最好设置为国内DNS，否则在代理的第一步就可能因为连接不上国外DNS而解析不出代理节点的IP，最终倒在起点
    - "https://doh.pub/dns-query#⚡️ 腾讯成都-自动测速"
  direct-nameserver:             # 规则匹配到直连时使用的DNS，既然是可以直连的，当然要用国内DNS
    - "https://doh.pub/dns-query#⚡️ 腾讯成都-自动测速"
  direct-nameserver-follow-policy: false  # 是否遵循 nameserver-policy，默认为不遵守，仅当 direct-nameserver 不为空时生效
  nameserver:                    # 在访问的国外网站没有匹配到任何域名规则，最终走了MATCH兜底规则时使用的DNS，为了确保不发生DNS泄漏和DNS污染，必须使用国外DNS   
    - "https://8.8.8.8/dns-query#⚡️ 腾讯HK1-自动测速&disable-ipv6=true&ecs=114.114.114.114/24&ecs-override=true"
  fallback:                      # 后备域名解析服务器，一般情况下使用境外 DNS, 保证结果可信
    - "https://1.1.1.1/dns-query#⚡️ 腾讯HK1-自动测速"
  fallback-filter:               # 后备域名解析服务器筛选，满足条件的将使用 fallback结果或只使用 fallback解析
    geoip: true                  # 启用 geoip 判断
    geoip-code: CN               # geoip国家缩写，默认值为 CN

# fake-ip-filter规则集
rule-providers:
  🚥 fakeip-filter:
    type: http
    behavior: domain
    interval: 172800
    proxy: ⚡️ 腾讯HK1-自动测速
