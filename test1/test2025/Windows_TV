proxy-groups:
  - name: "🎯 国内-手动-Windows"
    type: select
    proxies:
      - DIRECT
      - 🇨🇳 腾讯成都-80-TCP
      - ⚡️ 国内-机场-自动测速
    # 国内继机场配置
    filter: *includeNodes_CN
    exclude-filter: *excludeNodes_CN
    use:
      - ✈️ Airport_quick

  - name: "🌏 国外-手动-Windows"
    type: select
    proxies:
      - REJECT
      - ☄️ 国外-机场-自动测速
      - ♻️ 国外-自动-故障转移
      - ⚖️ 国外-负载均衡-轮询
      - 🇭🇰 腾讯HK1-80-TCP
      - 🇰🇷 春川AMD1-80-TCP
      - 🇰🇷 春川AMD2-80-TCP
      - 🇰🇷 春川ARM1-80-TCP
      - 🇰🇷 春川ARM2-80-TCP
      - 🇯🇵 腾讯JP1-80-TCP
    #国外机场配置
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - ✈️ Airport_shen7

  - name: "⚡️ 国内-机场-自动测速"
    type: url-test
    url: *test_url1
    interval: 333
    lazy: true
    # 国内继机场配置
    filter: *includeNodes_CN
    exclude-filter: *excludeNodes_CN
    use:
      - ✈️ Airport_quick

  - name: "☄️ 国外-机场-自动测速"
    type: url-test
    url: *test_url1
    interval: 333
    lazy: true
    # 国内继机场配置
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - ✈️ Airport_shen7

  - name: "♻️ 国外-自动-故障转移"
    type: fallback
    url: *test_url1
    interval: 333
    lazy: true
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    #proxies:
    #  - ⚖️ 国外-负载均衡-轮询
    use:
      - ✈️ Airport_shen7
      - ✈️ Airport_quick

  - name: "⚖️ 国外-负载均衡-轮询"
    type: load-balance
    url: *test_url1
    interval: 333
    lazy: true
    strategy: round-robin
    proxies:
      - 🇭🇰 腾讯HK1-80-TCP
      - 🇰🇷 春川AMD1-80-TCP
      - 🇰🇷 春川AMD2-80-TCP
      - 🇰🇷 春川ARM1-80-TCP
      - 🇰🇷 春川ARM2-80-TCP
      - 🇯🇵 腾讯JP1-80-TCP

