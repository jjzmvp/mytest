# 节点配置
proxy-groups:
  - name: "🎯 国内-手动-联通手厅"
    type: select
    proxies:
      - ⚡️ 腾讯成都-自动测速
    # 国内机场配置  
    filter: *includeNodes_CN
    exclude-filter: *excludeNodes_CN
    use:
      - 📡 Nodes_22001_shouting
      - ✈️ Airport_quick
  
  - name: "🌏 国外-手动-联通手厅"
    type: select
    proxies:
      - REJECT
      - ♻️ 国外-故障转移
      - ⚖️ 国外-负载均衡
    # 国外机场配置
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - 📡 Nodes_22001_shouting
      - ✈️ Airport_quick
   
  - name: "♻️ 国外-故障转移"
    type: fallback
    url: *test_url1
    interval: 600
    lazy: false
    filter: *includeNodes_GN
    exclude-filter: "国内|北京|上海|江苏|浙江|广东|四川|成都|移动|联通|电信|客户|校园|配合|官网|2x|3x|5x|10x|★★|✰✰|★★★|✰✰✰|腾讯成都|腾讯HK1"
    use:
      - ✈️ Airport_quick
      - 📡 Nodes_22001_shouting
      
  - name: "⚖️ 国外-负载均衡"
    type: load-balance
    url: *test_url1
    interval: 3600
    lazy: false
    strategy: round-robin
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - 📡 Nodes_22001_shouting

  - name: "⚡️ 腾讯成都-自动测速"
    type: url-test
    url: *test_url1
    interval: 3600
    lazy: false
    tolerance: 30
    filter: "腾讯成都-"
    use:
      - 📡 Nodes_22001_shouting

  - name: "⚡️ 腾讯HK1-自动测速"
    type: url-test
    url: *test_url1
    interval: 3600
    lazy: false
    tolerance: 30
    filter: "腾讯HK1-"
    use:
      - 📡 Nodes_22001_shouting

