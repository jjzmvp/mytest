# 节点配置
proxy-groups:
  - name: "🎯 国内-手动-WIFI"
    type: select
    proxies:
      - DIRECT
    # 国内继机场配置
    filter: *includeNodes_CN
    exclude-filter: *excludeNodes_CN
    use:
      - 📡 Nodes_tencent22002
      - ✈️ Airport_quick

  - name: "🌏 国外-手动-WIFI"
    type: select
    proxies:
      - REJECT
      - DIRECT
      - ☄️ 国外-自动测速
      - ♻️ 国外-故障转移
      - ⚖️ 国外-负载均衡
    #国外机场配置
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - 📡 Nodes_tencent22002
      - ✈️ Airport_shen7
      - ✈️ Airport_quick

  - name: "☄️ 国外-自动测速"
    type: url-test
    url: *test_url1
    interval: 600
    lazy: true
    tolerance: 50
    # 国内继机场配置
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - ✈️ Airport_shen7
      - ✈️ Airport_quick

  - name: "♻️ 国外-故障转移"
    type: fallback
    url: *test_url1
    interval: 600
    lazy: true
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - ✈️ Airport_shen7
      - ✈️ Airport_quick

  - name: "⚖️ 国外-负载均衡"
    type: load-balance
    url: *test_url1
    interval: 3600
    lazy: true
    strategy: round-robin
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - 📡 Nodes_tencent22002

  - name: "⚡️ 腾讯成都-自动测速"
    type: url-test
    url: *test_url1
    interval: 3600
    lazy: true
    filter: "腾讯成都"
    use:
      - 📡 Nodes_tencent22002

  - name: "⚡️ 腾讯HK1-自动测速"
    type: url-test
    url: *test_url1
    interval: 3600
    lazy: true
    filter: "腾讯HK1"
    use:
      - 📡 Nodes_tencent22002

