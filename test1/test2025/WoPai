# 节点配置
proxy-groups:
  - name: "🎯 国内-手动-联通沃派"
    type: select
    proxies:
      - DIRECT
      - ⚡️ 腾讯成都-TCP
    # 国内机场配置  
    filter: *includeNodes_CN
    exclude-filter: *excludeNodes_CN
    use:
      - 📡 Nodes_shouting22001
      - 📡 Nodes_dingtalk80
      - 📡 Nodes_toutiao22003
      - 📡 Nodes_bili22004
      - 📡 Nodes_tencent22002
  
  - name: "🌏 国外-手动-联通沃派"
    type: select
    proxies:
      - DIRECT
      - ⚖️ 国外-负载均衡-手厅
      - ⚓️ 国外-负载均衡-钉钉
      - 🔰 国外-负载均衡-头条
      - 📺 国外-负载均衡-哔哩
      - 🐧 国外-负载均衡-腾讯
