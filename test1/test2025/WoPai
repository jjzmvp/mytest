    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - 📡 Nodes_shouting22001
      - 📡 Nodes_dingtalk80
      - 📡 Nodes_toutiao22003
      - 📡 Nodes_bili22004
      - 📡 Nodes_tencent22002
      
  - name: "⚖️ 国外-负载均衡-手厅"
    type: load-balance
    url: *test_url1
    interval: 3600
    lazy: false
    strategy: round-robin
    filter: *includeNodes_GN
    exclude-filter: *excludeNodes_GN
    use:
      - 📡 Nodes_shouting22001

  - name: "⚓️ 国外-负载均衡-钉钉"
    type: load-balance
    url: *test_url1
    interval: 3600
    lazy: false
    strategy: round-robin
